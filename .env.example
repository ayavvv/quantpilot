# QuantPilot Configuration
# Copy to .env and fill in your values

# ============================================================
# Data Paths
# ============================================================
DATA_DIR=~/quantpilot_data
# DATA_DIR=/data                    # Docker default

# ============================================================
# NAS Data Source (for distributed deployment)
# Leave empty for single-machine setup
# ============================================================
NAS_HOST=
NAS_USER=
NAS_QLIB_PATH=/qlib_data
SSH_KEY=/path/to/ssh_private_key

# ============================================================
# Collector
# ============================================================
# Baostock: no credentials needed (free, socket-based)
CRON_TIME=16:30

# Futu OpenD (optional, for HK/US markets)
FUTU_HOST=localhost
FUTU_PORT=11111

# Extra codes (US ETFs, macro indices via Yahoo Finance)
# EXTRA_CODES=US.SPY,US.QQQ

# ============================================================
# Inference
# ============================================================
QLIB_DATA_DIR=/qlib_data
MODEL_DIR=/app/models
SIGNAL_DIR=/data/signals
MARKET=sh
# MODEL_NAME=lightgbm_sh_latest.pkl

# ============================================================
# Trader
# ============================================================
# FUTU_HOST=localhost
# FUTU_PORT=11111
# FUTU_RSA_KEY=/path/to/futu_rsa_private_key.pem
# A-share and US host scripts both use the host path directly.
# `docker-compose.mac.yml`
# mounts this file into the trader container automatically when it is configured.
# Host `scripts/run_trade.sh` overrides this to $DATA_DIR/signals/pred_sh_latest.pkl
# unless you call `python -m trader.trade_daily` directly.
PRED_PATH=/models/pred_sh.pkl
TOP_N=5
HOLD_BONUS=0.05
STOP_LOSS_PCT=-0.08
# 绑定指定模拟账户。0 表示使用 OpenD 返回的第一个模拟账户。
FUTU_SIM_ACC_ID=0
# 模板默认保持空跑；生产调度可在 .env 中改为 false。
DRY_RUN=true
# false 时，若 OpenD 判断沪深均未开市，则强制自动切到 dry-run。
ALLOW_OFF_HOURS_TRADING=false

# ============================================================
# US Deep Analysis Pipeline
# ============================================================
# nightly 默认走 S&P 500 成分股；US_TARGET_CODES 仅用于手工小范围联调，会覆盖 full-universe 行为。
US_UNIVERSE=sp500
# US_TARGET_CODES=US.AAPL,US.MSFT
# US_UNIVERSE_FILE=/path/to/us_universe.csv
# SP500_CACHE_PATH=$HOME/quantpilot_data/universes/sp500_symbols.json
# US_TARGET_INDEXES=US..SPX
US_SIGNAL_DIR=$DATA_DIR/signals/us
US_ANALYSIS_TOP_K=20
US_MAX_POSITIONS=5
US_MIN_PRICE=5
US_MIN_DOLLAR_VOLUME=10000000
US_ANALYSIS_TIMEOUT_SECONDS=3600
US_ANALYSIS_CONCURRENCY=10
US_FUTU_CONNECT_TIMEOUT_SECONDS=30
# 默认仅常规时段自动执行；若开启盘前/盘后，请显式改为 true。
# 对 US 链路同样生效。
# ALLOW_OFF_HOURS_TRADING=false

# ============================================================
# US Watchlist Deep Analysis Report
# ============================================================
US_WATCHLIST_FILE=$DATA_DIR/config/us_watchlist.json
US_WATCHLIST_REPORT_DIR=$DATA_DIR/reports/us_watchlist
US_WATCHLIST_CONCURRENCY=2
US_WATCHLIST_TIMEOUT_SECONDS=3600
US_WATCHLIST_RETRY_COUNT=0
US_WATCHLIST_SEND_EMAIL=true

# ============================================================
# Market-Wide Major Money Digest
# ============================================================
MAJOR_MONEY_EXPECTED_MARKETS=A,HK,US,US_OTC
# Futu does not support OTC/Pink capital-flow data; optional proxy uses Polygon/Massive daily aggregates.
ENABLE_US_OTC_PROXY_FLOW=false
US_OTC_PROXY_FLOW_PROVIDER=polygon
POLYGON_API_KEY=
US_OTC_PROXY_FLOW_EXCHANGE_TYPES=US_PINK
US_OTC_PROXY_FLOW_MAX_CODES=0
US_OTC_PROXY_FLOW_MIN_DOLLAR_VOLUME=0
# Optional YYYY-MM-DD override; default is the latest completed US session date.
US_OTC_PROXY_FLOW_DATE=

# ============================================================
# Reporter (SMTP email)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
REPORT_TO=
REPORT_FROM=

# ============================================================
# Weekly Trainer (Docker defaults are set in docker-compose.yml)
# ============================================================
# STRATEGY_DIR=/app
# MODELS_DIR=/data/models
# OUTPUT_DIR=/data/output
# TRADE_PRED_PATH=/data/models/pred_sh.pkl
# NAS_HOST=                     # Empty = skip NAS sync (use mounted data)
# NAS_USER=
# NAS_QLIB_PATH=/qlib_data
WEEKLY_TRAIN_TIMEOUT_SECONDS=43200
WEEKLY_BACKTEST_TIMEOUT_SECONDS=43200
WEEKLY_SIGNAL_PROMOTION_TIMEOUT_SECONDS=43200
# WEEKLY_STAGE_MODELS_ROOT=/path/to/quantpilot_data/models/weekly_runs
# WEEKLY_STAGE_OUTPUT_ROOT=/path/to/quantpilot_data/output/weekly_runs
# WEEKLY_PROMOTION_MIN_ANN_RETURN_DIFF=0.0
# WEEKLY_PROMOTION_MIN_SHARPE_DIFF=0.0
# WEEKLY_PROMOTION_MAX_DRAWDOWN_DELTA=0.01
EMAIL_FROM=
EMAIL_TO=

# ============================================================
# Polymarket Paper Trading
# ============================================================
POLY_DATA_DIR=$DATA_DIR/polymarket
POLY_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLY_CLOB_BASE_URL=https://clob.polymarket.com
POLY_CHAIN_ID=137
POLY_SCAN_INTERVAL_SECONDS=300
POLY_CATALOG_REFRESH_SECONDS=900
POLY_CATALOG_REFRESH_JOB_SECONDS=1800
POLY_MIN_NET_EDGE=0.01
POLY_MAX_BOOK_STALENESS_MS=15000
POLY_DEFAULT_GAS_COST=0
POLY_SLIPPAGE_BUFFER=0.005
POLY_TARGET_NOTIONAL_PER_OPP=25
POLY_MAX_NOTIONAL_PER_OPP=250
POLY_MIN_DEPTH_EDGE_PER_SHARE=0
POLY_MARKET_COOLDOWN_SECONDS=60
POLY_LOCAL_BOOK_DEPLETION_TTL_SECONDS=900
POLY_MAX_MARKET_NOTIONAL_PER_DAY=50
POLY_MAX_DAILY_NOTIONAL=250
POLY_MAX_DAILY_LOSS=25
POLY_PAPER_INITIAL_CASH=1000
POLY_PAPER_ONLY=true
POLY_ENABLE_SPLIT_SELL=true
POLY_MAX_ACTIVE_MARKETS=250
POLY_CATALOG_PAGE_SIZE=1000
POLY_CATALOG_FETCH_WORKERS=4
POLY_CATALOG_FETCH_FEE_RATES=true
POLY_BOOK_SOURCE=http
POLY_BOOK_FETCH_USE_BATCH=true
POLY_BOOK_FETCH_BATCH_SIZE=500
POLY_BOOK_FETCH_WORKERS=8
POLY_WS_MARKET_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLY_WS_HEARTBEAT_SECONDS=10
POLY_WS_RECONNECT_MIN_SECONDS=1
POLY_WS_RECONNECT_MAX_SECONDS=30
POLY_WS_READY_TIMEOUT_SECONDS=15
POLY_WS_MIN_READY_RATIO=0.95
POLY_WS_SUBSCRIBE_BATCH_SIZE=500
POLY_WS_RECONCILE_ENABLED=false
POLY_WS_RECONCILE_SECONDS=10
POLY_WS_RECONCILE_TIMEOUT_SECONDS=3
POLY_WS_RECONCILE_BATCH_SIZE=50
POLY_WS_RECONCILE_WORKERS=4
POLY_WS_RECONCILE_MAX_TOKENS_PER_CYCLE=500
POLY_DIRTY_SCAN_ENABLED=false
POLY_DIRTY_SCAN_INTERVAL_SECONDS=0.1
POLY_STORAGE_ASYNC_FLUSH_ENABLED=false
POLY_STORAGE_ASYNC_FLUSH_SECONDS=1
POLY_BOOK_TOP_SAMPLE_SECONDS=0
POLY_BOOK_TOP_RETENTION_HOURS=72
POLY_BOOK_TOP_RETENTION_JOB_SECONDS=3600
POLY_HTTP_TIMEOUT_SECONDS=20
POLY_USER_AGENT=Mozilla/5.0
POLY_ENABLE_TOP_TRADER_MIRROR=false
POLY_TOP_TRADER_CANDIDATE_LIMIT=25
POLY_TOP_TRADER_TRACKED_COUNT=3
POLY_TOP_TRADER_MIN_TRADES=10
POLY_TOP_TRADER_MIN_DIVERSITY=3
POLY_TOP_TRADER_POLL_SECONDS=300
POLY_TOP_TRADER_MIRROR_LAG_SECONDS=300
POLY_TOP_TRADER_MIN_SIGNAL_SIZE=50
POLY_TOP_TRADER_MAX_SIGNAL_NOTIONAL=100
POLY_EMAIL_REPORT_ENABLED=false
POLY_EMAIL_REPORT_ATTACH_JSON=true
